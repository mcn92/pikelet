{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mcn92/pikelet/main/packages/pikelet/schemas/v1/pikelet.config.schema.json",
  "type": "object",
  "required": ["version", "name", "source", "chunking", "embedding", "index", "validation"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "folder" },
            "path": { "type": "string" },
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } },
            "routeBaseUrl": { "type": "string" },
            "routePrefix": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "url" },
            "url": { "type": "string" },
            "maxPages": { "type": "integer", "minimum": 1 },
            "includeUrl": { "type": "array", "items": { "type": "string" } },
            "excludeUrl": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "git" },
            "path": { "type": "string" },
            "rev": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "conversations" },
            "path": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "chunking": {
      "type": "object",
      "required": ["targetTokens", "overlapPercent"],
      "properties": {
        "targetTokens": { "type": "integer", "minimum": 32 },
        "overlapPercent": { "type": "integer", "minimum": 0, "maximum": 50 }
      },
      "additionalProperties": false
    },
    "embedding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "buildModel", "dims"],
          "properties": {
            "mode": { "const": "workers-ai" },
            "buildModel": { "enum": ["bge-small-en-v1.5"] },
            "dims": { "const": 384 },
            "prefixPolicy": {
              "type": "object",
              "properties": {
                "passage": { "type": "string" },
                "query": { "type": "string" }
              }
            },
            "pooling": { "enum": ["mean"] },
            "normalize": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "studentModelPath", "dims"],
          "properties": {
            "mode": { "const": "student" },
            "studentModelPath": { "type": "string" },
            "teacherVectorsPath": { "type": "string" },
            "trainStudent": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "outDir": { "type": "string" },
                "python": { "type": "string" },
                "teacher": { "type": "string" },
                "teacherRevision": { "type": "string" },
                "epochs": { "type": "integer", "minimum": 1 },
                "buckets": { "type": "integer", "minimum": 1 },
                "hidden": { "type": "integer", "minimum": 1 },
                "batchSize": { "type": "integer", "minimum": 1 },
                "learningRate": { "type": "number", "exclusiveMinimum": 0 },
                "maxFeatures": { "type": "integer", "minimum": 1 },
                "seed": { "type": "integer" },
                "skipAbstention": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            "dims": { "const": 384 },
            "prefixPolicy": {
              "type": "object",
              "properties": {
                "passage": { "type": "string" },
                "query": { "type": "string" }
              }
            },
            "pooling": { "enum": ["mean"] },
            "normalize": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "dims"],
          "properties": {
            "mode": { "const": "inline-transformer" },
            "teacherVectorsPath": { "type": "string" },
            "dims": { "const": 384 },
            "prefixPolicy": {
              "type": "object",
              "properties": {
                "passage": { "type": "string" },
                "query": { "type": "string" }
              }
            },
            "pooling": { "enum": ["mean"] },
            "normalize": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "index": {
      "type": "object",
      "required": ["metric", "quantized", "M", "efConstruction", "efSearch"],
      "properties": {
        "metric": { "enum": ["cosine"] },
        "quantized": { "type": "boolean" },
        "M": { "type": "integer", "minimum": 2, "maximum": 128 },
        "efConstruction": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "efSearch": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "sentenceWindows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Complete runtime only: also index every run of this many consecutive sentences of each chunk, mapped back to the chunk (2 recommended). Packs built this way cannot be extended with append."
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["mode", "storage"],
      "properties": {
        "mode": { "enum": ["snapshot", "artifact", "complete"] },
        "storage": { "enum": ["bundled"] },
        "artifactPath": { "type": "string" },
        "profile": { "enum": ["kind3"] },
        "fileName": { "type": "string" },
        "inlineEncoder": {
          "type": "object",
          "required": ["vocabPath", "weightsPath"],
          "properties": {
            "vocabPath": { "type": "string" },
            "weightsPath": { "type": "string" },
            "calibrationPath": { "type": "string" },
            "model": { "type": "string" },
            "maxTokens": { "type": "integer", "minimum": 1 },
            "license": { "type": "string" },
            "attribution": { "type": "string" },
            "layout": { "type": "object" },
            "declaration": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["minRecallAt10"],
      "properties": {
        "minRecallAt10": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
