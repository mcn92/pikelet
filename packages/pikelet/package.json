{
  "name": "pikelet",
  "version": "0.12.0",
  "mcpName": "io.github.mcn92/pikelet",
  "description": "Compile docs into a complete .pikelet search artifact, or scaffold a Pikelet-backed search app.",
  "type": "module",
  "bin": {
    "pikelet": "bin/pikelet.mjs"
  },
  "exports": {
    "./docusaurus": "./docusaurus/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "docusaurus",
    "src",
    "tools",
    "templates",
    "schemas",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "smoke": "PIKELET_SEARCH_STUB_EMBEDDINGS=1 node bin/pikelet.mjs --name /tmp/pikelet-search-smoke --source ../docs --no-deploy --yes --force"
  },
  "dependencies": {
    "pikelet-wasm": "^0.12.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "license": "Apache-2.0"
}
